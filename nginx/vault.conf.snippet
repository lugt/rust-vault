# ===== vault 反代 begin =====
# 限流 zone 必须放在 http {} 顶层（不是 server {}）。
# 请在 http { ... } 里添加（或确认已有）：
#   limit_req_zone $binary_remote_addr zone=vault_api:10m rate=5r/s;

# 静态 SPA 入口：访问 /keychain 跳到 /keychain/
location = /keychain {
    return 301 /keychain/;
}

# 1) API 反代（精确前缀 + 优先级 ^~，不会被其他 location 抢走）
#    Rust 的 API 路径是 /vault/...，所以匹配 /keychain/vault 开头即可
#    GET/PUT /keychain/vault → Rust
#    POST /keychain/vault/rekey → Rust
location ^~ /keychain/vault {
    # 去掉 /keychain/ 前缀，Rust 看到 /vault/...
    rewrite ^/keychain/(.*)$ /$1 break;

    limit_req zone=vault_api burst=10 nodelay;

    proxy_pass http://127.0.0.1:8080;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # 防 DoS
    client_max_body_size 8m;

    # 超时
    proxy_connect_timeout 5s;
    proxy_send_timeout    30s;
    proxy_read_timeout    30s;
}

# 2) 静态文件：所有其他 /keychain/* 走 alias
#    alias 必须带尾部斜杠（与 location 的尾部斜杠匹配）。
#    Nginx worker 用户（通常是 www-data / nginx）必须能读这个目录。
#    常见路径：
#      /var/www/vault/keychain/         （生产部署）
#      /usr/local/erpshared/vault-web/   （已部署示例）
#      /home/claw/vault-web/             （用户自管）
# 已知坑：不要在此处用 try_files（try_files + alias 在 Nginx 里路径解析错位）
location /keychain/ {
    alias /usr/local/erpshared/vault-web/;
    index index.html;
}
# ===== vault 反代 end =====